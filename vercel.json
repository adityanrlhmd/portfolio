{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/tools/:path*", "destination": "/tools.html" },
    { "source": "/case-study/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/resume", "destination": "/tools/resume", "permanent": true },
    {
      "source": "/cover-letter",
      "destination": "/tools/cover-letter",
      "permanent": true
    },
    {
      "source": "/keyword-check",
      "destination": "/tools/keyword-check",
      "permanent": true
    }
  ]
}
